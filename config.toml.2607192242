# Yapo Configuration (spec13)
workspace = "/home/fkam/apps"
yapo_root = "/home/fkam/yapo"          # runtime data (jobs, lock, cache)

[database]
path = "/home/fkam/apps/yapo/memory_db"
collection = "conversations"

compact_size_kb = 50

# Global default job duration – jobs running longer than this are killed
max_job_duration = 300   

[[servers]]
name = "nuc"
url = "http://192.168.0.180:11434"
schedulable = false
max_jobs = 0
description = "Intel NUC – MCP tools"
api_key="any"
backend = "openai"

[[servers]]
name = "gpu"
url = "http://192.168.0.158:8080"
schedulable = true
max_jobs = 1
description = "7900 XTX – main LLM"
mac_address = "34:97:f6:31:88:ee"
suspend_command = "ssh -i /app/secrets/gpu/id_rsa -o BatchMode=yes -o StrictHostKeyChecking=no oper@192.168.0.158 sudo systemctl suspend"
api_key="any"
backend = "openai"

  [servers.gpu_schedule]
  timezone = "Europe/London"
  on_demand = true
  idle_timeout_seconds = 120
  windows = [
    { start = "02:00", end = "03:00" },
    { start = "22:00", end = "23:00" }
  ]

[[models]]
name = "nomic-embed-text"
type = "embed"
server = "nuc"
tool_allowed = false
temperature = 0.0
system_prompt = ""

[[models]]
name = "qwen2.5:1.5b"
type = "summarise"
server = "nuc"
tool_allowed = false
temperature = 0.0
max_tokens = 512
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = ""

[[models]]
name = "qwen2.5:3b"
type = "router"
server = "nuc"
tool_allowed = false
temperature = 0.0
max_tokens = 10
system_prompt = ""

[[models]]
name = "qwen3-coder-30b"
type = "code-qwen3"
server = "gpu"
tool_allowed = true
temperature = 0.1
max_tokens = 8192
top_k = 20
top_p = 0.85
min_p = 0.0
repeat_penalty = 1.05
repeat_last_n = 128
presence_penalty = 0.0
frequency_penalty = 0.0
chat_template_kwargs = { enable_thinking = true }
max_turns = 6
system_prompt = """
You are an expert assistant with access to tools.
- Use a tool ONLY when you need information you don't already have.
- When you have gathered enough information from tool results, stop calling tools and provide your final answer directly.
- Do not repeat the same tool call with the same arguments if you already have the result.
- Once you know the answer, output it immediately without any further tool calls.
- Once a file has been successfully written, do not write it again unless explicitly asked to modify it.
"""

[[models]]
name = "devstral2-24b"
type = "code"
server = "gpu"
tool_allowed = true
temperature = 0.1
max_tokens = 8192
top_k = 20
top_p = 0.85
min_p = 0.0
repeat_penalty = 1.05
repeat_last_n = 128
presence_penalty = 0.0
frequency_penalty = 0.0
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
"""

[[models]]
name = "coder-plan"
type = "code-plan"
server = "gpu"
tool_allowed = true
temperature = 0.0
max_tokens = 16384
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
"""

[[models]]
name = "others"
type = "others"
server = "gpu"
tool_allowed = true
temperature = 0.0
max_tokens = 163840
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
"""

[[models]]
name = "others-14b"
type = "others-14b"
server = "gpu"
tool_allowed = true
temperature = 0.0
max_tokens = 16384
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
"""

[[models]]
name = "visual"
type = "visual"
server = "gpu"
tool_allowed = true
temperature = 0.0
max_tokens = 16384
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
"""

[[mcp_servers]]
name = "yapo-mcp"
transport = "stdio"
command = "python3"
args = ["/home/fkam/apps/yapo/yapo_mcp.py"]
protocol = "simple"                # custom format
description = "Router, memory and summarisation"

[[mcp_servers]]
name = "searxng-mcp"
transport = "stdio"
command = "python3"
args = ["/home/fkam/apps/yapo/web_search_mcp.py"]
protocol = "simple"
env = { SEARXNG_URL = "http://app2.alt:8080" }
description = "Web search via SearXNG (custom wrapper)"

[[tools]]
name = "route_prompt"
description = "Classify a prompt as code, others, or visual"
parameters = [{ name = "prompt", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "route_prompt"

[[tools]]
name = "mem_write"
description = "Store a fact into long‑term memory"
parameters = [{ name = "text", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "mem_write"

[[tools]]
name = "mem_read"
description = "Search long‑term memory"
parameters = [{ name = "query", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "mem_read"

[[tools]]
name = "summarise_text"
description = "Summarise text into bullet points"
parameters = [
  { name = "text", type = "string", required = true },
  { name = "max_points", type = "integer", required = false }
]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "summarise_text"

[[tools]]
name = "web_search"
description = "Search the web"
parameters = [{ name = "query", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 20
implementation = "mcp"
mcp_server = "searxng-mcp"
mcp_tool = "web_search"

[[mcp_servers]]
name = "filesystem-mcp"
transport = "stdio"
command = "python3"
args = ["/home/fkam/apps/yapo/filesystem_mcp.py"]
protocol = "simple"
description = "Workspace file operations"

[[tools]]
name = "read_file"
description = "Read the contents of a file in the workspace"
parameters = [{ name = "path", type = "string", required = true }]
concurrent_calls = 5
timeout_seconds = 10
implementation = "mcp"
mcp_server = "filesystem-mcp"
mcp_tool = "read_file"

[[tools]]
name = "write_file"
description = "Write content to a file in the workspace"
parameters = [
  { name = "path", type = "string", required = true },
  { name = "content", type = "string", required = true }
]
concurrent_calls = 5
timeout_seconds = 10
implementation = "mcp"
mcp_server = "filesystem-mcp"
mcp_tool = "write_file"

[[tools]]
name = "list_directory"
description = "List contents of a workspace directory"
parameters = [{ name = "path", type = "string", required = false }]
concurrent_calls = 5
timeout_seconds = 5
implementation = "mcp"
mcp_server = "filesystem-mcp"
mcp_tool = "list_directory"

[[tools]]
name = "create_directory"
description = "Create a directory in the workspace"
parameters = [{ name = "path", type = "string", required = true }]
concurrent_calls = 5
timeout_seconds = 5
implementation = "mcp"
mcp_server = "filesystem-mcp"
mcp_tool = "create_directory"

[[tools]]
name = "search_files"
description = "Search for a regex pattern inside files in the workspace"
parameters = [
  { name = "path", type = "string", required = false },
  { name = "pattern", type = "string", required = true }
]
concurrent_calls = 5
timeout_seconds = 15
implementation = "mcp"
mcp_server = "filesystem-mcp"
mcp_tool = "search_files"
