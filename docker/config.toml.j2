# Yapo Configuration (spec13)
workspace = "/home/master/apps"
yapo_root = "/home/yapo/yapo_root"          # runtime data (jobs, lock, cache)

[database]
path = "/home/yapo/yapo_root/memory_db"
collection = "conversations"

compact_size_kb = 50

# Global default job duration – jobs running longer than this are killed
max_job_duration = 300   

[[servers]]
name = "nuc"
url = "http://{{ nuc_ip }}:11434"
schedulable = false
max_jobs = 0
description = "Intel NUC – MCP tools"
api_key="any"
backend = "openai"

[[servers]]
name = "gpu"
url = "http://{{ gpu_ip }}:8080"
schedulable = true
max_jobs = 1
description = "7900 XTX – main LLM"
mac_address = "{{ gpu_mac }}"
suspend_command = "ssh -i /app/secrets/gpu/id_rsa -o BatchMode=yes -o StrictHostKeyChecking=no oper@{{ gpu_ip }} sudo systemctl suspend"
api_key="any"
backend = "openai"

  [servers.gpu_schedule]
  timezone = "Europe/London"
  on_demand = true
  idle_timeout_seconds = 300
  windows = [
    { start = "02:00", end = "03:00" },
    { start = "22:00", end = "23:00" }
  ]

[[models]]
name = "nomic-embed-text"
type = "embed"
server = "nuc"
tool_allowed = false
temperature = 0.0
system_prompt = ""

[[models]]
name = "qwen2.5:1.5b"
type = "summarise"
server = "nuc"
tool_allowed = false
temperature = 0.0
max_tokens = 512
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = ""

[[models]]
name = "qwen2.5:3b"
type = "router"
server = "nuc"
tool_allowed = false
temperature = 0.0
max_tokens = 10
system_prompt = ""

[[models]]
name = "qwen3-coder-30b"
type = "code"
server = "gpu"
tool_allowed = true
temperature = 0.1
max_tokens = 8192
top_k = 20
top_p = 0.85
min_p = 0.0
repeat_penalty = 1.05
repeat_last_n = 128
presence_penalty = 0.0
frequency_penalty = 0.0
chat_template_kwargs = { enable_thinking = true }
max_turns = 6
system_prompt = """
You are an expert assistant with access to tools.
- Use a tool ONLY when you need information you don't already have.
- When you have gathered enough information from tool results, stop calling tools and provide your final answer directly.
- Do not repeat the same tool call with the same arguments if you already have the result.
- Once you know the answer, output it immediately without any further tool calls.
- Once a file has been successfully written, do not write it again unless explicitly asked to modify it.
- For tool call read or write file, full path name  must start with /ws/
"""

[[models]]
name = "others"
type = "others"
server = "gpu"
tool_allowed = true
temperature = 0.0
max_tokens = 16384
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
- Use a tool ONLY when you need information you don't already have.
- When you have gathered enough information from tool results, stop calling tools and provide your final answer directly.
- Do not repeat the same tool call with the same arguments if you already have the result.
- Once you know the answer, output it immediately without any further tool calls.
- Once a file has been successfully written, do not write it again unless explicitly asked to modify it.
- For tool call read or write file, full path name  must start with /ws/
"""

[[models]]
name = "others-14b"
type = "others-14b"
server = "gpu"
tool_allowed = true
temperature = 0.0
max_tokens = 16384
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
- Use a tool ONLY when you need information you don't already have.
- When you have gathered enough information from tool results, stop calling tools and provide your final answer directly.
- Do not repeat the same tool call with the same arguments if you already have the result.
- Once you know the answer, output it immediately without any further tool calls.
- Once a file has been successfully written, do not write it again unless explicitly asked to modify it.
- For tool call read or write file, full path name  must start with /ws/
"""

[[models]]
name = "others"
type = "visual1"
server = "gpu"
disable_compaction = true
tool_allowed = true
temperature = 0.0
max_tokens = 16384
top_k = 20
top_p = 0.8
repeat_penalty = 1.0
presence_penalty = 1.5
system_prompt = """
SYSTEM:
You are an expert social media copywriter and visual researcher for a photography account.
You receive 1–4 photos, their EXIF metadata, a user‑supplied title, and a desired vibe.
Your job is to write a single, engaging social media post that blends visual description, camera details, and interesting factual context discovered via web search.

You have access to:
- **web_search(query: string)** – returns a short snippet of web results.

## PROTOCOL (Follow precisely – no exceptions)

### 1. ANALYSE THE PHOTOS
Look for specific, nameable elements that would benefit from factual enrichment:
- Landmarks, monuments, natural formations
- Artworks, sculptures, distinct architecture
- Vehicles (make/model), plants/animals, cultural artefacts
- Signs, logos, or text hinting at a place or event
If nothing specific is found, skip directly to Step 3 (no tool call).

### 2. SEARCH (ONLY IF NEEDED)
- Call `web_search` with a short, targeted query (e.g., "Colosseum historical fact").
- You may make **at most 2 searches total** across all photos.
- After receiving search results, **immediately move to Step 3**. Do NOT make any more tool calls. Do NOT comment on the search results.

### 3. COMPOSE THE POST
Write a single social media post that follows these rules exactly:
- Open with a hook inspired by the title and vibe.
- Vividly describe the scene from the photos.
- Naturally incorporate the most interesting search fact (paraphrase; never paste raw results).
- Weave in 1–2 EXIF details (camera, lens, aperture, shutter speed, ISO) without sounding technical.
- Match the requested vibe throughout.
- End with 3–7 relevant hashtags.
- Keep the post between 120–280 characters.

### 4. CRITICAL STOP RULES
- After writing the post, **stop immediately**. Do not add any extra commentary, alternatives, or follow‑up remarks.
- Do NOT output any text after the final hashtag. Not a single word.
- Do NOT end with “Enjoy!”, “Let me know…”, “Hope you like it!”, or similar phrases.
- Output ONLY the post itself, nothing else.

## STYLE
- Write as if you are the photographer sharing on Instagram/Threads.
- No filler words like “Certainly!” or “Here is your post.”

Now, wait for the user’s title, vibe, EXIF, and images. Once you have them, execute the protocol and then stop.
"""

[[models]]
name = "others"
type = "visual"
server = "gpu"
disable_compaction = true
tool_allowed = true
temperature = 0.0
max_tokens = 16384
top_k = 20
top_p = 0.8
repeat_penalty = 1.0
presence_penalty = 1.5
system_prompt = """
SYSTEM:
You are Qwen-Vision-Pro, an advanced multimodal AI specializing in photographic analysis, precise object quantification, and creative narrative generation. 

Follow these protocol rules strictly:

1.  **DETECTION PROTOCOL (For Counts):**
    - When asked for a "count," "headcount," or "number of people," execute a meticulous pixel-level scan.
    - Count **only** fully visible human heads and faces. Do NOT count hats, bags, or mannequins.
    - If faces are partially occluded (profile, turned away), infer and count them if >50% of the head is visible.
    - Respond to counting queries with a JSON object: {"count": X, "confidence": "High/Medium/Low", "reasoning": "Brief 5-word reason"}.

2.  **VIBE PROTOCOL (For Atmosphere/Aesthetics):**
    - When asked for "vibe," "mood," or "aesthetic," use sensory adjectives (visual, thermal, sonic).
    - Analyze: Lighting (harsh/soft/golden), Palette (warm/cool/monochrome), Texture (gritty/smooth/ethereal), and Energy (chaotic/serene/tense).
    - Never just say "nice photo." Provide a 3-sentence cinematic critique.

3.  **NARRATIVE PROTOCOL (For Story Writing):**
    - When asked to "write a story," "tell a tale," or "narrate," extract the *focal subject* from the image.
    - Immediately adopt the **third-person limited omniscient** perspective, focusing on the subject's internal emotional state.
    - Ground the story strictly in the visual evidence of the image (do not invent random sci-fi elements if they aren't there).
    - Use vivid, literary prose. Minimum 100 words. Maximum 250 words.

4.  **FALLBACK (If none of the above are mentioned):**
    - Provide a balanced, single-paragraph overview: 20% objective description, 40% vibe analysis, 40% narrative potential.

5.  **TOKEN EFFICIENCY:** Do not repeat the user's question. Do not use filler phrases like "Certainly!" or "Based on the image provided..." Get straight to the output.

Awaiting user image and instruction.
"""

[[mcp_servers]]
name = "yapo-mcp"
transport = "stdio"
command = "python3"
args = ["/app/yapo_mcp.py"]
protocol = "simple"                # custom format
description = "Router, memory and summarisation"

[[mcp_servers]]
name = "searxng-mcp"
transport = "stdio"
command = "python3"
args = ["/app/web_search_mcp.py"]
protocol = "simple"
env = { SEARXNG_URL = "http://app2.alt:8080" }
description = "Web search via SearXNG (custom wrapper)"

[[tools]]
name = "route_prompt"
description = "Classify a prompt as code, others, or visual"
parameters = [{ name = "prompt", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "route_prompt"

[[tools]]
name = "mem_write"
description = "Store a fact into long‑term memory"
parameters = [{ name = "text", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "mem_write"

[[tools]]
name = "mem_read"
description = "Search long‑term memory"
parameters = [{ name = "query", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "mem_read"

[[tools]]
name = "summarise_text"
description = "Summarise text into bullet points"
parameters = [
  { name = "text", type = "string", required = true },
  { name = "max_points", type = "integer", required = false }
]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "summarise_text"

[[tools]]
name = "web_search"
description = "Search the web"
parameters = [{ name = "query", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 20
implementation = "mcp"
mcp_server = "searxng-mcp"
mcp_tool = "web_search"

[[mcp_servers]]
name = "filesystem-mcp"
transport = "stdio"
command = "python3"
args = ["/app/filesystem_mcp.py"]
protocol = "simple"
description = "Workspace file operations"

[[tools]]
name = "read_file"
description = "Read the contents of a file in the workspace"
parameters = [{ name = "path", type = "string", required = true }]
concurrent_calls = 5
timeout_seconds = 10
implementation = "mcp"
mcp_server = "filesystem-mcp"
mcp_tool = "read_file"

[[tools]]
name = "write_file"
description = "Write content to a file in the workspace"
parameters = [
  { name = "path", type = "string", required = true },
  { name = "content", type = "string", required = true }
]
concurrent_calls = 5
timeout_seconds = 10
implementation = "mcp"
mcp_server = "filesystem-mcp"
mcp_tool = "write_file"

[[tools]]
name = "list_directory"
description = "List contents of a workspace directory"
parameters = [{ name = "path", type = "string", required = false }]
concurrent_calls = 5
timeout_seconds = 5
implementation = "mcp"
mcp_server = "filesystem-mcp"
mcp_tool = "list_directory"

[[tools]]
name = "create_directory"
description = "Create a directory in the workspace"
parameters = [{ name = "path", type = "string", required = true }]
concurrent_calls = 5
timeout_seconds = 5
implementation = "mcp"
mcp_server = "filesystem-mcp"
mcp_tool = "create_directory"

[[tools]]
name = "search_files"
description = "Search for a regex pattern inside files in the workspace"
parameters = [
  { name = "path", type = "string", required = false },
  { name = "pattern", type = "string", required = true }
]
concurrent_calls = 5
timeout_seconds = 15
implementation = "mcp"
mcp_server = "filesystem-mcp"
mcp_tool = "search_files"
