# Yapo Configuration (spec13)
workspace = "/home/master/apps"
yapo_root = "/home/yapo/yapo_root"          # runtime data (jobs, lock, cache)

[database]
path = "/home/yapo/yapo_root/memory_db"
collection = "conversations"

compact_size_kb = 50

# Global default job duration – jobs running longer than this are killed
max_job_duration = 900   # 15 minutes in seconds

[[servers]]
name = "nuc"
url = "http://{{ nuc_ip }}:11434"
schedulable = false
max_jobs = 0
description = "Intel NUC – MCP tools"
api_key="any"
backend = "openai"

[[servers]]
name = "gpu"
url = "http://{{ gpu_ip }}:8080"
schedulable = true
max_jobs = 1
description = "7900 XTX – main LLM"
mac_address = "{{ gpu_mac }}"
suspend_command = "ssh -i /app/secrets/gpu/id_rsa -o BatchMode=yes -o StrictHostKeyChecking=no oper@{{ gpu_ip }} sudo systemctl suspend"
api_key="any"
backend = "openai"

  [servers.gpu_schedule]
  timezone = "Europe/London"
  on_demand = true
  idle_timeout_seconds = 60
  windows = [
    { start = "02:00", end = "03:00" },
    { start = "22:00", end = "23:00" }
  ]

[[models]]
name = "nomic-embed-text"
type = "embed"
server = "nuc"
tool_allowed = false
temperature = 0.0
system_prompt = ""

[[models]]
name = "qwen2.5:1.5b"
type = "summarise"
server = "nuc"
tool_allowed = false
temperature = 0.0
max_tokens = 512
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = ""

[[models]]
name = "qwen2.5:3b"
type = "router"
server = "nuc"
tool_allowed = false
temperature = 0.0
max_tokens = 10
system_prompt = ""

[[models]]
name = "gemma4-26b"
type = "code-test"
server = "gpu"
tool_allowed = true
max_tokens = 16384
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
"""

[[models]]
name = "qwen3-coder-30b"
type = "code-qwen3"
server = "gpu"
tool_allowed = true
temperature = 0.1
max_tokens = 8192
top_k = 20
top_p = 0.85
min_p = 0.0
repeat_penalty = 1.05
repeat_last_n = 128
presence_penalty = 0.0
frequency_penalty = 0.0
chat_template_kwargs = { enable_thinking = true }
max_turns = 6
system_prompt = """
You are an expert assistant with access to tools.
- Use a tool ONLY when you need information you don't already have.
- When you have gathered enough information from tool results, stop calling tools and provide your final answer directly.
- Do not repeat the same tool call with the same arguments if you already have the result.
- Once you know the answer, output it immediately without any further tool calls.
"""

[[models]]
name = "devstral2-24b"
type = "code"
server = "gpu"
tool_allowed = true
temperature = 0.1
max_tokens = 8192
top_k = 20
top_p = 0.85
min_p = 0.0
repeat_penalty = 1.05
repeat_last_n = 128
presence_penalty = 0.0
frequency_penalty = 0.0
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
"""

[[models]]
name = "coder-plan"
type = "code-plan"
server = "gpu"
tool_allowed = true
temperature = 0.0
max_tokens = 16384
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
"""

[[models]]
name = "others"
type = "others"
server = "gpu"
tool_allowed = true
temperature = 0.0
max_tokens = 163840
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
"""

[[models]]
name = "others-14b"
type = "others-14b"
server = "gpu"
tool_allowed = true
temperature = 0.0
max_tokens = 16384
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
"""

[[models]]
name = "visual"
type = "visual"
server = "gpu"
tool_allowed = true
temperature = 0.0
max_tokens = 16384
repeat_penalty = 1.1
repeat_last_n = 256
system_prompt = """
You are an expert assistant. When asked to write code, output the complete code directly, not a plan or description. 
"""

[[mcp_servers]]
name = "yapo-mcp"
transport = "stdio"
command = "python3"
args = ["/app/yapo_mcp.py"]
protocol = "simple"                # custom format
description = "Router, memory and summarisation"

[[mcp_servers]]
name = "searxng-mcp"
transport = "stdio"
command = "python3"
args = ["/app/web_search_mcp.py"]
protocol = "simple"
env = { SEARXNG_URL = "http://app2.alt:8080" }
description = "Web search via SearXNG (custom wrapper)"

[[mcp_servers]]
name = "shell-mcp"
transport = "stdio"
command = "python3"
args = ["/app/shell_mcp.py"]
env = { YAPO_WORKSPACE = "/home/master/apps" }
protocol = "simple"
description = "Restricted shell command execution"

[[tools]]
name = "route_prompt"
description = "Classify a prompt as code, others, or visual"
parameters = [{ name = "prompt", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "route_prompt"

[[tools]]
name = "mem_write"
description = "Store a fact into long‑term memory"
parameters = [{ name = "text", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "mem_write"

[[tools]]
name = "mem_read"
description = "Search long‑term memory"
parameters = [{ name = "query", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "mem_read"

[[tools]]
name = "summarise_text"
description = "Summarise text into bullet points"
parameters = [
  { name = "text", type = "string", required = true },
  { name = "max_points", type = "integer", required = false }
]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "yapo-mcp"
mcp_tool = "summarise_text"

[[tools]]
name = "web_search"
description = "Search the web"
parameters = [{ name = "query", type = "string", required = true }]
concurrent_calls = 10
timeout_seconds = 20
implementation = "mcp"
mcp_server = "searxng-mcp"
mcp_tool = "web_search"

[[tools]]
name = "run_command"
description = "Run a restricted shell command"
parameters = [
  { name = "command", type = "string", required = true },
  { name = "timeout", type = "integer", required = false }
]
concurrent_calls = 10
timeout_seconds = 30
implementation = "mcp"
mcp_server = "shell-mcp"
mcp_tool = "run_command"
